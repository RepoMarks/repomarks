# ===== 数据仓库 (必填) =====
# 支持 HTTPS 或 SSH，例如:
#   https://github.com/yourname/link-data.git
#   https://gitea.example.com/yourname/link-data.git
#   git@gitea.example.com:yourname/link-data.git
REPO_URL=
# HTTPS 访问令牌 (GitHub PAT / Gitea token / GitLab token)。SSH 方式留空即可。
# 各平台的详细获取步骤见 README 的 Access tokens 章节（中文见 README-CN.md）。
GIT_TOKEN=
# Basic 认证用户名：GitHub 保持 x-access-token，Gitea 填你的用户名，GitLab 填 oauth2
GIT_USERNAME=x-access-token
# 分支，默认 main
GIT_BRANCH=main
# SSH 私钥路径（仅 SSH 方式需要）
GIT_SSH_KEY=
# Git LFS：auto = 检测到 git-lfs 就自动启用（archives/ 与 files/ 存指针）
# true = 强制要求（未安装则启动失败）；false = 关闭
GIT_LFS=auto
# 本地克隆目录
DATA_DIR=./data

# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
# 反向代理子路径，例如 /repomarks（前后端需同时生效，前端构建时设置 VITE_BASE_PATH）
BASE_PATH=
# 访问密码，留空则不启用登录（建议设置）
AUTH_PASSWORD=
# 会话签名密钥，留空则根据密码和仓库地址派生（重启后仍有效）
SESSION_SECRET=

# ===== 行为 =====
# 每个 JSONL 分片的链接数
SHARD_SIZE=1000
# 后台自动同步间隔（秒），0 表示只手动/写入时同步
SYNC_INTERVAL=60
# 抓取元数据的超时（毫秒）
FETCH_TIMEOUT=15000
# 网页存档引擎: auto | singlefile | basic | off
ARCHIVE_ENGINE=auto
# 存档格式（逗号分隔）: html, readable, screenshot, pdf, wayback
# screenshot/pdf 需要 Chrome/Chromium；wayback 需要同时打开 ARCHIVE_WAYBACK
ARCHIVE_FORMATS=html,readable,screenshot,pdf
# 是否把页面提交到 Wayback Machine（外部服务，较慢）
ARCHIVE_WAYBACK=false
# 定时重新存档：超过 N 天未更新的存档会被重新抓取（0 = 关闭）
REFRESH_ARCHIVE_DAYS=0
# 每次定时任务最多重新抓取几条
REFRESH_ARCHIVE_LIMIT=5
# 外部 RSS 订阅源同步间隔（小时，0 = 关闭）
FEED_SYNC_INTERVAL_HOURS=0
# 归档正文全文搜索索引（索引文件存放在仓库 index/search.jsonl）
FULLTEXT_INDEX=true
# 每条链接参与全文搜索的最大字符数（影响内存占用）
FULLTEXT_MAX_CHARS=2000

# ===== AI 标签与摘要（可选） =====
# OpenAI 兼容接口地址，例如 https://api.openai.com/v1
# 本地 Ollama 可用 http://host.docker.internal:11434/v1（Docker 部署时）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 向量模型（用于语义搜索/问答），如 text-embedding-3-small 或 nomic-embed-text
AI_EMBEDDING_MODEL=
AI_TIMEOUT=30000
# Chromium/Chrome 可执行文件路径，留空自动探测
ARCHIVE_BROWSER_PATH=
# 额外的浏览器启动参数（逗号分隔），Docker 中通常需要 --no-sandbox
ARCHIVE_BROWSER_ARGS=
# 单次存档超时（毫秒）
ARCHIVE_TIMEOUT=90000
# 允许抓取/存档内网地址（默认禁止，防 SSRF）
ALLOW_PRIVATE_URLS=false
# 提交作者
GIT_AUTHOR_NAME=RepoMarks
GIT_AUTHOR_EMAIL=repomarks@localhost
